# ==============================================================================
# APPLICATION
# ==============================================================================

# Display name of the application
APP_NAME=Telecare

# Name of the session cookie stored in the browser
SESSION_COOKIE_NAME=teleassist_session

# Port the server will listen on inside the container
PORT=8000


# ==============================================================================
# SECURITY
# ==============================================================================

# Secret key used to encrypt session cookies.
# Generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to true when serving over HTTPS (always true in production)
USE_HTTPS=true


# ==============================================================================
# DATABASE
# ==============================================================================

# PostgreSQL connection string used by the application.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# The values here must match DB_USER, DB_PASSWORD and DB_NAME below.
# In Docker Compose, HOST is the name of the db service (e.g. "db")
DATABASE_URL=postgresql+psycopg2://telecare:change-me@db:5432/telecare

# PostgreSQL service credentials (used by Docker Compose to create the database)
DB_USER=telecare
DB_PASSWORD=change-me
DB_NAME=telecare


# ==============================================================================
# ADMIN CREDENTIALS (first-time setup)
# ==============================================================================

# Email used to log into the Technician (admin) dashboard
TECHNICIAN_EMAIL=admin@example.com

# Password for the Technician dashboard. Use a strong password.
TECHNICIAN_PASSWORD=change-me


# ==============================================================================
# SERVER
# ==============================================================================

# Never set RELOAD=true in production — it disables performance optimizations
RELOAD=false
